<Window x:Class="DevTools.LaunchPlanStagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启动阶段编排"
        Width="850"
        Height="620"
        MinWidth="720"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="#E5E7EB"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock x:Name="WindowTitleText"
                       Text="启动阶段编排"
                       FontSize="23"
                       FontWeight="Bold"/>

            <TextBlock Text="不同阶段按顺序执行，同一阶段内的服务后续将支持并行启动。"
                       Foreground="#94A3B8"
                       Margin="0,7,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#111827"
                BorderBrush="#253047"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14">
                    <TextBlock Text="阶段列表"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="StageCountText"
                               Text="共 0 个阶段"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <DataGrid x:Name="StageDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="#0F172A"
                          Foreground="#E5E7EB"
                          BorderBrush="#334155"
                          RowBackground="#1E293B"
                          AlternatingRowBackground="#172033"
                          HorizontalGridLinesBrush="#334155"
                          VerticalGridLinesBrush="#334155"
                          MinHeight="220">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="顺序"
                                            Binding="{Binding Order}"
                                            Width="65"/>

                        <DataGridTextColumn Header="阶段名称"
                                            Binding="{Binding Name}"
                                            Width="2*"/>

                        <DataGridTextColumn Header="服务数量"
                                            Binding="{Binding ServiceIds.Count}"
                                            Width="100"/>

                        <DataGridTextColumn Header="执行方式"
                                            Binding="{Binding ExecutionMode}"
                                            Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <WrapPanel Grid.Row="2"
                           Margin="0,14,0,0">
                    <Button Content="新增阶段"
                            Background="#2563EB"
                            Click="AddStage_Click"/>

                    <Button Content="编辑阶段"
                            Click="EditStage_Click"/>

                    <Button Content="删除阶段"
                            Click="DeleteStage_Click"/>

                    <Button Content="上移"
                            Click="MoveUp_Click"/>

                    <Button Content="下移"
                            Click="MoveDown_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">

            <Button Content="取消"
                    Click="Cancel_Click"/>

            <Button Content="保存阶段配置"
                    Background="#2563EB"
                    Margin="0"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>

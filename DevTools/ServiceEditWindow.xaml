<Window x:Class="DevTools.ServiceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Java 服务配置"
        Width="760"
        Height="820"
        MinWidth="680"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="#E5E7EB">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="CaretBrush" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Margin="0,0,0,20">
            <TextBlock x:Name="WindowTitleText"
                       Text="添加 Java 服务"
                       FontSize="23"
                       FontWeight="Bold"/>

            <TextBlock Text="配置项目路径、启动方式及 Spring Boot 运行参数。"
                       Foreground="#94A3B8"
                       Margin="0,7,0,0"/>
        </StackPanel>

        <!-- 表单 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <TextBlock Text="基本信息"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                <TextBlock Text="服务名称 *" Margin="0,0,0,6"/>
                <TextBox x:Name="NameTextBox"
                         Height="38"
                         Margin="0,0,0,16"/>

                <TextBlock Text="启动方式 *" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,18">
                    <RadioButton x:Name="MavenRadioButton"
                                 Content="Maven 项目"
                                 IsChecked="True"
                                 GroupName="StartMode"/>

                    <RadioButton x:Name="JarRadioButton"
                                 Content="JAR 文件"
                                 GroupName="StartMode"/>
                </StackPanel>

                <TextBlock Text="项目目录"
                           Margin="0,0,0,6"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ProjectPathTextBox"
                             Height="38"/>

                    <Button Grid.Column="1"
                            Content="浏览目录"
                            Click="BrowseProjectPath_Click"
                            Margin="10,0,0,0"/>
                </Grid>

                <TextBlock Text="JAR 文件路径（JAR 启动时必填）"
                           Margin="0,0,0,6"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="JarPathTextBox"
                             Height="38"/>

                    <Button Grid.Column="1"
                            Content="选择文件"
                            Click="BrowseJarPath_Click"
                            Margin="10,0,0,0"/>
                </Grid>

                <TextBlock Text="Maven 模块名称（多模块项目使用）"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="ModuleNameTextBox"
                         Height="38"
                         Margin="0,0,0,16"/>

                <TextBlock Text="主类名称（可选）"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="MainClassTextBox"
                         Height="38"
                         Margin="0,0,0,22"/>

                <TextBlock Text="运行参数"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                <TextBlock Text="服务端口 *"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="PortTextBox"
                         Height="38"
                         Text="8080"
                         Margin="0,0,0,16"/>

                <TextBlock Text="Spring Profile"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="ProfileTextBox"
                         Height="38"
                         Margin="0,0,0,16"/>

                <TextBlock Text="JVM 参数"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="JvmArgumentsTextBox"
                         Height="65"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         Margin="0,0,0,16"/>

                <TextBlock Text="Spring Boot 启动参数"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="ApplicationArgumentsTextBox"
                         Height="65"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         Margin="0,0,0,16"/>

                <TextBlock Text="环境变量（每行一个，格式：KEY=VALUE）"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="EnvironmentVariablesTextBox"
                         Height="85"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         Margin="0,0,0,16"/>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="取消"
                    Click="Cancel_Click"/>

            <Button Content="保存服务"
                    Background="#2563EB"
                    Click="Save_Click"
                    Margin="0"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="DevTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevTools 开发者工具箱"
        Width="1200" Height="760"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120"
        Foreground="#E5E7EB"
        FontFamily="Microsoft YaHei UI"
        Icon="DevTools.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111827"/>
        <SolidColorBrush x:Key="CardBrush" Color="#182235"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#60A5FA"/>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAB7CA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#233149"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#30435F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="#29364B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>


        <!-- 统一暗色 ComboBox 样式 -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Foreground" Value="#E5E7EB"/>
                        <Setter Property="Background" Value="#182235"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder"
                                                    Property="Background"
                                                    Value="#334155"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder"
                                                    Property="Background"
                                                    Value="#1D4ED8"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground"
                                                    Value="#64748B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                        Grid.Column="0"
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                        IsHitTestVisible="False"/>

                                <ToggleButton
                                        Grid.Column="1"
                                        Focusable="False"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsChecked="{Binding IsDropDownOpen,
                                RelativeSource={RelativeSource TemplatedParent},
                                Mode=TwoWay}">
                                    <Path Data="M 0 0 L 4 4 L 8 0"
                                          Stroke="#94A3B8"
                                          StrokeThickness="1.5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </ToggleButton>
                            </Grid>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#182235"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        MinWidth="{Binding ActualWidth,
                                    RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer
                                            CanContentScroll="True"
                                            MaxHeight="300">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder"
                                        Property="BorderBrush"
                                        Value="#60A5FA"/>
                            </Trigger>

                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder"
                                        Property="BorderBrush"
                                        Value="#60A5FA"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- 统一 DataGrid 表头暗色样式 -->
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0"
                Background="#0F172A"
                BorderBrush="#253047"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="18,22">

                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,30">
                        <Border Width="38" Height="38"
                                Background="#2563EB"
                                CornerRadius="10">
                            <TextBlock Text="D"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,1,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DevTools"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="开发者工具箱"
                                       FontSize="11"
                                       Foreground="#94A3B8"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="工作空间"
                               Foreground="#64748B"
                               FontSize="11"
                               Margin="10,0,0,8"/>

                    <Button x:Name="DashboardNav"
                            Style="{StaticResource NavButton}"
                            Background="#1D3558"
                            Foreground="#93C5FD"
                            Click="DashboardNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" FontSize="19" Width="28"/>
                            <TextBlock Text="工作台" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="PortNav"
                            Style="{StaticResource NavButton}"
                            Click="PortNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌘" FontSize="17" Width="28"/>
                            <TextBlock Text="端口管理" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ProcessNav"
                            Style="{StaticResource NavButton}"
                            Click="ProcessNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" FontSize="17" Width="28"/>
                            <TextBlock Text="进程管理" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="JavaServiceNav"
                            Style="{StaticResource NavButton}"
                            Click="JavaServiceNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" FontSize="17" Width="28"/>
                            <TextBlock Text="Java 服务" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ScriptNav"
                            Style="{StaticResource NavButton}"
                            Click="ScriptNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▧" FontSize="17" Width="28"/>
                            <TextBlock Text="脚本编码工具" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="系统"
                               Foreground="#64748B"
                               FontSize="11"
                               Margin="10,26,0,8"/>

                    <Button x:Name="AboutNav"
                            Style="{StaticResource NavButton}"
                            Click="AboutNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ⓘ" FontSize="17" Width="28"/>
                            <TextBlock Text="关于软件" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="LogsNav"
                            Style="{StaticResource NavButton}"
                            Click="LogsNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ⓘ" FontSize="17" Width="28"/>
                            <TextBlock Text="操作日志" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SettingsNav"
                            Style="{StaticResource NavButton}"
                            Click="SettingsNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ⓘ" FontSize="17" Width="28"/>
                            <TextBlock Text="软件设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="#182235"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="运行状态"
                                   Foreground="#94A3B8"
                                   FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse Width="8" Height="8"
                                     Fill="#34D399"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="应用运行正常"
                                       Foreground="#D1FAE5"
                                       FontSize="12"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text=".NET 10 · WPF"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- 右侧主区域 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="#253047"
                    BorderThickness="0,0,0,1"
                    Padding="28,0">
                <Grid>
                    <TextBlock x:Name="PageTitle"
                               Text="工作台"
                               FontSize="17"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="LOCAL DEVELOPER TOOLKIT"
                               Foreground="#64748B"
                               FontSize="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <Grid Margin="28">
                    <!-- 工作台 -->

                    <StackPanel x:Name="DashboardPage">
                        <TextBlock Text="工作台"
                                   FontSize="25"
                                   FontWeight="Bold"/>

                        <TextBlock Text="本机开发环境概况与常用工具入口。"
                                   Foreground="#94A3B8"
                                   Margin="0,8,0,22"/>

                        <WrapPanel Margin="0,0,0,10">
                            <Border Style="{StaticResource CardBorder}"
                                    Width="260"
                                    Margin="0,0,16,16">
                                <StackPanel>
                                    <TextBlock Text="运行中的进程"
                                               FontSize="14"
                                               Foreground="#94A3B8"/>

                                    <TextBlock x:Name="DashboardProcessCount"
                                               Text="--"
                                               FontSize="36"
                                               FontWeight="Bold"
                                               Margin="0,10,0,4"/>

                                    <TextBlock Text="当前读取到的进程数量"
                                               Foreground="#94A3B8"
                                               FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}"
                                    Width="260"
                                    Margin="0,0,16,16">
                                <StackPanel>
                                    <TextBlock Text="TCP 监听端口"
                                               FontSize="14"
                                               Foreground="#94A3B8"/>

                                    <TextBlock x:Name="DashboardPortCount"
                                               Text="--"
                                               FontSize="36"
                                               FontWeight="Bold"
                                               Margin="0,10,0,4"/>

                                    <TextBlock Text="当前检测到的监听记录"
                                               Foreground="#94A3B8"
                                               FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <Border Style="{StaticResource CardBorder}"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="常用工具"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,16"/>

                                <WrapPanel>
                                    <Button Content="端口管理"
                                            Style="{StaticResource ActionButton}"
                                            Click="PortNav_Click"
                                            Margin="0,0,12,10"/>

                                    <Button Content="进程管理"
                                            Style="{StaticResource ActionButton}"
                                            Click="ProcessNav_Click"
                                            Margin="0,0,12,10"/>

                                    <Button Content="脚本编码工具"
                                            Style="{StaticResource ActionButton}"
                                            Click="ScriptNav_Click"
                                            Margin="0,0,12,10"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="工作台状态"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <TextBlock x:Name="DashboardStatus"
                                           Text="正在获取系统概况……"
                                           Foreground="#CBD5E1"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14"/>

                                <TextBlock x:Name="DashboardUpdatedAt"
                                           Text="最近刷新：尚未刷新"
                                           Foreground="#94A3B8"
                                           Margin="0,0,0,16"/>

                                <Button Content="刷新工作台数据"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource ActionButton}"
                                        Click="RefreshDashboard_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>


                    <!-- 端口管理 -->
                    <StackPanel x:Name="PortPage" Visibility="Collapsed">
                        <TextBlock Text="端口管理"
                                   FontSize="25"
                                   FontWeight="Bold"/>

                        <TextBlock Text="查询本机 TCP 监听端口、进程 PID 和进程名称。"
                                   Foreground="#94A3B8"
                                   Margin="0,8,0,22"/>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="TCP 监听端口"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="PortSummary"
                                           Text="准备查询"
                                           Foreground="#94A3B8"
                                           Margin="0,8,0,18"/>


                                <DockPanel Margin="0,0,0,16">
                                    <Button Content="刷新"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource ActionButton}"
                                            Click="RefreshPorts_Click"
                                            Margin="8,0,0,0"/>

                                    <Button Content="复制结果"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource ActionButton}"
                                            Click="CopyPortResult_Click"
                                            Margin="8,0,0,0"/>

                                    <Button Content="结束占用进程"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource ActionButton}"
                                            Click="KillPortProcess_Click"
                                            Margin="8,0,0,0"/>

                                    <TextBox x:Name="PortSearchBox"
                                             Height="38"
                                             Padding="10,8"
                                             FontSize="13"
                                             Background="#0F172A"
                                             Foreground="#E5E7EB"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             VerticalContentAlignment="Center"
                                             ToolTip="输入端口号、PID、IP 地址或进程名称"
                                             TextChanged="PortSearchBox_TextChanged"/>
                                </DockPanel>


                                <DataGrid x:Name="PortDataGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          Background="#111827"
                                          Foreground="#E5E7EB"
                                          BorderBrush="#334155"
                                          RowBackground="#111827"
                                          AlternatingRowBackground="#182235"
                                          HorizontalGridLinesBrush="#29364B"
                                          VerticalGridLinesBrush="#29364B"
                                          ColumnHeaderHeight="38"
                                          RowHeight="36"
                                          MinHeight="300"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="本地地址"
                                                            Binding="{Binding LocalAddress}"
                                                            Width="2*"/>

                                        <DataGridTextColumn Header="端口"
                                                            Binding="{Binding Port}"
                                                            Width="70"/>

                                        <DataGridTextColumn Header="PID"
                                                            Binding="{Binding ProcessId}"
                                                            Width="85"/>

                                        <DataGridTextColumn Header="进程名称"
                                                            Binding="{Binding ProcessName}"
                                                            Width="2*"/>

                                        <DataGridTextColumn Header="状态"
                                                            Binding="{Binding Status}"
                                                            Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- 分页控制 -->
                                <Border Margin="0,12,0,0"
                                        Padding="10"
                                        Background="#182235"
                                        CornerRadius="6">
                                    <DockPanel LastChildFill="True">

                                        <TextBlock x:Name="PortPageInfo"
                                                   DockPanel.Dock="Left"
                                                   Text="第 1 / 1 页"
                                                   Foreground="#CBD5E1"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right">

                                            <Button Content="首页"
                                                    Click="PortFirstPage_Click"
                                                    Style="{StaticResource ActionButton}"
                                                    Margin="0,0,6,0"/>

                                            <Button Content="上一页"
                                                    Click="PortPreviousPage_Click"
                                                    Style="{StaticResource ActionButton}"
                                                    Margin="0,0,6,0"/>

                                            <Button Content="下一页"
                                                    Click="PortNextPage_Click"
                                                    Style="{StaticResource ActionButton}"
                                                    Margin="0,0,6,0"/>

                                            <Button Content="末页"
                                                    Click="PortLastPage_Click"
                                                    Style="{StaticResource ActionButton}"/>

                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <TextBlock x:Name="PortMessage"
                                           Text="点击刷新获取数据。"
                                           Foreground="#94A3B8"
                                           Margin="0,14,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 进程管理 -->
                    <StackPanel x:Name="ProcessPage" Visibility="Collapsed">
                        <TextBlock Text="进程管理"
                                   FontSize="25"
                                   FontWeight="Bold"/>

                        <TextBlock Text="查看运行中的进程、PID 和内存占用，也可以结束选中的进程。"
                                   Foreground="#94A3B8"
                                   Margin="0,8,0,22"/>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="运行中的进程"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="ProcessSummary"
                                           Text="准备查询"
                                           Foreground="#94A3B8"
                                           Margin="0,8,0,18"/>

                                <DockPanel Margin="0,0,0,16">
                                    <Button Content="刷新"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource ActionButton}"
                                            Click="RefreshProcesses_Click"
                                            Margin="12,0,0,0"/>

                                    <Button Content="结束选中进程"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource ActionButton}"
                                            Click="KillProcess_Click"
                                            Margin="0,0,12,0"/>

                                    <TextBox x:Name="ProcessSearchBox"
                                             Height="38"
                                             Padding="10,8"
                                             FontSize="13"
                                             Background="#0F172A"
                                             Foreground="#E5E7EB"
                                             BorderBrush="#334155"
                                             BorderThickness="1"
                                             VerticalContentAlignment="Center"
                                             ToolTip="输入进程名称或 PID"
                                             TextChanged="ProcessSearchBox_TextChanged"/>
                                </DockPanel>

                                <DataGrid x:Name="ProcessDataGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          Background="#111827"
                                          Foreground="#E5E7EB"
                                          BorderBrush="#334155"
                                          RowBackground="#111827"
                                          AlternatingRowBackground="#182235"
                                          HorizontalGridLinesBrush="#29364B"
                                          VerticalGridLinesBrush="#29364B"
                                          ColumnHeaderHeight="38"
                                          RowHeight="36"
                                          MinHeight="300"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="进程名称"
                                                            Binding="{Binding ProcessName}"
                                                            Width="2*"/>

                                        <DataGridTextColumn Header="PID"
                                                            Binding="{Binding ProcessId}"
                                                            Width="90"/>

                                        <DataGridTextColumn Header="内存占用（MB）"
                                                            Binding="{Binding MemoryMb, StringFormat=N2}"
                                                            Width="150"/>

